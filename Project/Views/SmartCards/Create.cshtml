@model Project.Models.SmartCard

@{
    ViewData["Title"] = "Thêm SmartCard";
}

<h2>THÊM SMARTCARD</h2>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="PassengerId" class="control-label">Hành khách</label>
        <select asp-for="PassengerId" class="form-control">
            <option value="">-- Chọn hành khách --</option>
            @foreach (var passenger in ViewBag.Passengers)
            {
                <option value="@passenger.PassengerId">@passenger.FullName</option>
            }
        </select>
        <span asp-validation-for="PassengerId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NfcCode" class="control-label">Mã NFC</label>
        <input asp-for="NfcCode" class="form-control" />
        <span asp-validation-for="NfcCode" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Balance" class="control-label">Số dư</label>
        <input asp-for="Balance" class="form-control" />
        <span asp-validation-for="Balance" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="IssueDate" class="control-label">Ngày cấp</label>
        <input asp-for="IssueDate" type="datetime-now" class="form-control" />
        <span asp-validation-for="IssueDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Thêm</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
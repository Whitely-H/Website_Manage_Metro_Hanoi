@{
    ViewData["Title"] = "Trang chủ";
}

<!-- HERO -->
<section class="metro-hero">
    <div class="metro-hero__text">
        <h1>Di chuyển khắp Hà Nội<br />bằng đường sắt đô thị</h1>
        <p>Tra cứu tuyến, giờ chạy tàu và giá vé chỉ trong vài giây.</p>
    </div>
    <div class="metro-quickfare metro-card">
        <div class="metro-card__body">
            <h5 class="mb-3">Tra cứu hành trình</h5>
            <form asp-controller="Schedules" asp-action="Index" method="get" class="row g-2">
                <div class="col-12">
                    <label class="form-label">Ga đi</label>
                    <select class="form-select" name="fromStationId">
                        <option value="STA-CL">Cát Linh</option>
                        <option value="STA-NHON">Nhổn</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Ga đến</label>
                    <select class="form-select" name="toStationId">
                        <option value="STA-HD">Hà Đông</option>
                        <option value="STA-GHN">Ga Hà Nội</option>
                    </select>
                </div>

                <div class="col-12 mt-3">
                    <button type="submit" class="metro-btn w-100">Xem giá vé &amp; giờ chạy</button>
                </div>
            </form>
        </div>
    </div>
</section>
@if (!string.IsNullOrWhiteSpace(ViewBag.Search))
{
    <div class="mt-4">
        <h3>Kết quả tìm kiếm: "@ViewBag.Search"</h3>

        @if (ViewBag.SearchLines.Count > 0)
        {
            <h5>Tuyến</h5>
            foreach (var line in ViewBag.SearchLines)
            {
                <p>
                    <a asp-controller="Lines" asp-action="Details" asp-route-id="@line.LineID">
                        @line.LineName
                    </a>
                </p>
            }
        }

        @if (ViewBag.SearchStations.Count > 0)
        {
            <h5>Ga</h5>
            foreach (var station in ViewBag.SearchStations)
            {
                <p>
                    <a asp-controller="Stations" asp-action="Details" asp-route-id="@station.StationId">
                        @station.StationName
                    </a>
                </p>
            }
        }

        @if (ViewBag.SearchLines.Count == 0 && ViewBag.SearchStations.Count == 0)
        {
            <p>Không tìm thấy kết quả.</p>
        }
    </div>
}

<section class="metro-section">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h2 class="h4 mb-0">Tuyến đang khai thác</h2>
        <a asp-controller="Lines" asp-action="Index" class="metro-btn metro-btn--outline">Xem tất cả</a>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="metro-card">
                <div class="metro-card__body">
                    <span class="metro-line-chip metro-line-chip--2a"></span>
                    <div class="metro-card__title"><a asp-controller="Lines" asp-action="Index"> Tuyến 2A: Cát Linh – Hà Đông</a></div>
                    <div class="metro-card__meta"><a asp-controller="Lines" asp-action="Index">12 ga · Tuyến 2A · Hoạt động</a></div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="metro-card">
                <div class="metro-card__body">
                    <span class="metro-line-chip metro-line-chip--3"></span>
                    <div class="metro-card__title">Tuyến 3: Nhổn – Ga Hà Nội</div>
                    <div class="metro-card__meta">12 ga · Tuyến 3 · Hoạt động</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="metro-section metro-operation">
    <div class="metro-operation__header">
        <div><h2 class="h4 mb-1">Trạng thái vận hành</h2><div class="metro-operation__updated">Thông tin vận hành hiện tại</div></div>
        <a asp-controller="Schedules" asp-action="Index" class="metro-btn metro-btn--outline">Xem lịch trình</a>
    </div>

    <div class="metro-operation__summary">
        <span class="metro-operation__status-icon"></span>
        <div class="metro-operation__summary-content">
            <div class="metro-operation__summary-title">2/2 tuyến đang hoạt động</div>
            <div class="metro-operation__summary-meta">Không có thông báo gián đoạn được hiển thị.</div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="metro-card metro-operation__line">
                <div class="metro-card__body">
                    <div class="metro-operation__line-head">
                        <div class="metro-operation__line-info">
                            <span class="metro-line-chip metro-line-chip--2a"></span>
                            <div><div class="metro-operation__line-name">Tuyến 2A: Cát Linh – Hà Đông</div><div class="metro-operation__line-route">12 ga · Hoạt động bình thường</div></div>
                        </div>
                        <span class="metro-status-badge">Đang hoạt động</span>
                    </div>
                    <div class="metro-operation__details">
                        <div class="metro-operation__detail"><span class="metro-operation__detail-label">Chuyến tiếp theo</span><span class="metro-operation__detail-value">10:55</span></div>
                        <div class="metro-operation__detail"><span class="metro-operation__detail-label">Tần suất</span><span class="metro-operation__detail-value">6–8 phút</span></div>
                    </div>
                    <div class="metro-operation__action"><a asp-controller="Schedules" asp-action="Index" class="metro-btn metro-btn--outline">Xem lịch trình</a></div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="metro-card metro-operation__line">
                <div class="metro-card__body">
                    <div class="metro-operation__line-head">
                        <div class="metro-operation__line-info">
                            <span class="metro-line-chip metro-line-chip--3"></span>
                            <div><div class="metro-operation__line-name">Tuyến 3: Nhổn – Ga Hà Nội</div><div class="metro-operation__line-route">12 ga · Hoạt động bình thường</div></div>
                        </div>
                        <span class="metro-status-badge">Đang hoạt động</span>
                    </div>
                    <div class="metro-operation__details">
                        <div class="metro-operation__detail"><span class="metro-operation__detail-label">Chuyến tiếp theo</span><span class="metro-operation__detail-value">10:58</span></div>
                        <div class="metro-operation__detail"><span class="metro-operation__detail-label">Tần suất</span><span class="metro-operation__detail-value">7–10 phút</span></div>
                    </div>
                    <div class="metro-operation__action"><a asp-controller="Schedules" asp-action="Index" class="metro-btn metro-btn--outline">Xem lịch trình</a></div>
                </div>
            </div>
        </div>
    </div>
</section>



<section class="metro-section">
    <h2 class="h4 mb-3">Tin tức &amp; thông báo vận hành</h2>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="metro-card">
                <div class="metro-card__body">
                    <div class="metro-card__meta">20/09/2026</div>
                    <div class="metro-card__title">Điều chỉnh giờ chạy tàu dịp lễ</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="metro-card">
                <div class="metro-card__body">
                    <div class="metro-card__meta">15/09/2026</div>
                    <div class="metro-card__title">Mở bán vé tháng qua ứng dụng</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="metro-card">
                <div class="metro-card__body">
                    <div class="metro-card__meta">10/09/2026</div>
                    <div class="metro-card__title">Thông báo bảo trì Tuyến 3</div>
                </div>
            </div>
        </div>
    </div>
</section>
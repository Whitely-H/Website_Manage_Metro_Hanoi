@model Project.Models.Line

@{
    ViewData["Title"] = "Xóa tuyến";
}

<h1>Xóa tuyến</h1>

<h3>Bạn có chắc chắn muốn xóa tuyến này không?</h3>

<div>
    <h4>Thông tin tuyến</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LineID)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LineID)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LineName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LineName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ColorCode)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ColorCode)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.LineID" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="LineID" />

        <button type="submit" class="btn btn-danger">
            Xóa
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại
        </a>
    </form>
</div>
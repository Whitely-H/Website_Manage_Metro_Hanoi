@model Project.Models.Line

@{
    ViewData["Title"] = "Chi tiết tuyến";
}

<h1>Chi tiết tuyến</h1>

<div>
    <h4>Line</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LineID)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LineID)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LineName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LineName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ColorCode)
        </dt>
        <dd class="col-sm-10">
            <span style="
                display:inline-block;
                width:30px;
                height:20px;
                background-color:@Model.ColorCode;
                border:1px solid #ccc;
                vertical-align:middle;">
            </span>
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model?.LineID"
       class="btn btn-primary">
        Chỉnh sửa
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại danh sách
    </a>
</div>
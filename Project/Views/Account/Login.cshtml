@model Project.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Metro Hà Nội</title>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: #F5F6F8;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-box {
            width: 100%;
            max-width: 420px;
            padding: 40px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
        }

        .login-title {
            text-align: center;
            color: #0B2545;
            margin-bottom: 30px;
        }

        .role-btn {
            width: 100%;
            margin-bottom: 12px;
            padding: 12px;
        }

        .form-group {
            margin-bottom: 16px;
        }
    </style>
</head>

<body>

    <div class="login-box">

        <h2 class="login-title">METRO HÀ NỘI</h2>

        @if (string.IsNullOrEmpty(Model.Role))
        {
            <p class="text-center">
                Đăng nhập với tư cách là:
            </p>

            <div class="mt-4">
                <a asp-action="Login"
                   asp-route-role="Guest"
                   class="btn btn-secondary role-btn">
                    Khách
                </a>

                <a asp-action="Login"
                   asp-route-role="Staff"
                   class="btn btn-primary role-btn">
                    Nhân viên
                </a>

                <a asp-action="Login"
                   asp-route-role="Admin"
                   class="btn btn-danger role-btn">
                    Admin
                </a>
            </div>
        }
        else if (Model.Role == "Guest")
        {
            <h4 class="text-center">Khách</h4>

            <p class="text-center">
                Bạn có thể sử dụng hệ thống mà không cần đăng nhập.
            </p>

            <form asp-action="Login"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <input type="hidden"
                       asp-for="Role"
                       value="Guest" />

                <button type="submit"
                        class="btn btn-primary role-btn">
                    Tiếp tục
                </button>

            </form>
        }
        else
        {
            <h4 class="text-center">
                @(Model.Role == "Admin" ? "Admin" : "Nhân viên")
            </h4>

            <form asp-action="Login"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <input type="hidden"
                       asp-for="Role" />

                <div class="form-group">
                    <label asp-for="Username">
                        Tên đăng nhập
                    </label>

                    <input asp-for="Username"
                           class="form-control" />

                    <span asp-validation-for="Username"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">
                        Mật khẩu
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="btn btn-primary role-btn mt-2">
                    Đăng nhập
                </button>

                <a asp-action="Login"
                   class="btn btn-secondary role-btn">
                    Quay lại
                </a>

            </form>
        }

    </div>

</body>
</html>
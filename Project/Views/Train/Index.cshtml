@model IEnumerable<Project.Models.Train>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Staff"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create new</a>
    </p>
}
else
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Mua vé</a>
    </p>

}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TrainCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LineId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Capacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Line)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Schedules)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TrainCode)
            </td>
            <td>
                @Html.DisplayFor(model => item.LineId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Capacity)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                @Html.DisplayFor(model => item.Line)
            </td>
            <td>
                @Html.DisplayFor(model => item.Schedules)
            </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.TrainId" class="btn btn-info btn-sm">Chi tiết</a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.TrainId" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.TrainId" class="btn btn-danger btn-sm">Xóa</a>
                    }
                </td>
        </tr>
}
    </tbody>
</table>

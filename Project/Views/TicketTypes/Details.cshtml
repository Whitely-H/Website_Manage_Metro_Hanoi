@model Project.Models.TicketType

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>TicketType</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TicketTypeId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TicketTypeId)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TypeName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TypeName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class="col-sm-10">
            @Model.Price.ToString("N0") VNĐ
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DurationHours)
        </dt>
        <dd class="col-sm-10">
            @if (Model.DurationHours == null)
            {
                <span>Không xác định</span>
            }
            else if (Model.DurationHours >= 720)
            {
                <span>30 ngày</span>
            }
            else
            {
                <span>@Model.DurationHours giờ</span>
            }
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model?.TicketTypeId"
       class="btn btn-warning">
        Sửa
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model?.TicketTypeId"
       class="btn btn-danger">
        Xóa
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại danh sách
    </a>
</div>
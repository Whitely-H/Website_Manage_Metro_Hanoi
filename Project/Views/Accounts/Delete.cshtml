@model Project.Models.Account

@{
    ViewData["Title"] = "Xóa tài khoản";
}

<h2>XÓA TÀI KHOẢN</h2>

<h4>Bạn có chắc chắn muốn xóa tài khoản này?</h4>

<div>
    <dl class="row">
        <dt class="col-sm-2">Tên đăng nhập</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Username)</dd>

        <dt class="col-sm-2">Vai trò</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Role)</dd>

        <dt class="col-sm-2">Mã ga</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StationId)</dd>

        <dt class="col-sm-2">Tên ga</dt>
        <dd class="col-sm-10">@Model.Station?.StationName</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="AccountId" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>
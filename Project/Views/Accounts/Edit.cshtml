@model Project.Models.Account

@{
    ViewData["Title"] = "Sửa tài khoản";
}

<h2>SỬA TÀI KHOẢN</h2>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="AccountId" />

    <div class="form-group mb-3">
        <label asp-for="Username" class="control-label">Tên đăng nhập</label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="PasswordHash" class="control-label">Mật khẩu mới</label>
        <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Để trống nếu không đổi" />
        <span asp-validation-for="PasswordHash" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Role" class="control-label">Vai trò</label>
        <select asp-for="Role" class="form-control">
            <option value="Admin">Admin</option>
            <option value="Staff">Staff</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="StationId" class="control-label">Mã ga</label>
        <select asp-for="StationId" class="form-control">
            <option value="">-- Không chọn ga --</option>
            @foreach (var station in ViewBag.Stations)
            {
                <option value="@station.StationId">
                    @station.StationId - @station.StationName
                </option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}